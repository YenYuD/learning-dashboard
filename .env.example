# Database connection string
# For local development with PostgreSQL
DATABASE_URL=postgresql://postgres:@localhost:5432/learning-dashboard

# For Supabase Database (recommended for deployment)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# For Vercel Postgres
# DATABASE_URL=[VERCEL_POSTGRES_URL]
